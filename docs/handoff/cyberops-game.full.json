        {
          "cond": "hasTag",
          "target": "selected",
          "tag": "lost",
          "not": true
        },
        {
          "cond": "timerRunning",
          "id": "respond",
          "target": "selected",
          "not": true
        },
        {
          "cond": "compare",
          "left": "$var.budget",
          "op": ">=",
          "right": 120
        }
      ],
      "then": [
        {
          "do": "addVar",
          "var": "budget",
          "by": -120
        },
        {
          "do": "startTimer",
          "id": "respond",
          "seconds": 11,
          "target": "selected",
          "data": {
            "answer": "restore"
          }
        },
        {
          "do": "log",
          "text": "Restore started on {selected.name}."
        }
      ]
    },
    {
      "id": "respond-correct",
      "when": {
        "event": "timer",
        "id": "respond"
      },
      "if": [
        {
          "cond": "compare",
          "left": "$timer.answer",
          "op": "==",
          "right": "$self.row.correct"
        }
      ],
      "then": [
        {
          "do": "removeTag",
          "tag": "occupied"
        },
        {
          "do": "setProp",
          "prop": "status",
          "value": "healthy"
        },
        {
          "do": "stopTimer",
          "id": "slow",
          "target": "self"
        },
        {
          "do": "stopTimer",
          "id": "fail",
          "target": "self"
        },
        {
          "do": "addVar",
          "var": "breach",
          "by": -5,
          "min": 0
        },
        {
          "do": "addVar",
          "var": "stopped",
          "by": 1
        },
        {
          "do": "log",
          "text": "{self.name} cleared."
        }
      ]
    },
    {
      "id": "respond-wrong",
      "when": {
        "event": "timer",
        "id": "respond"
      },
      "if": [
        {
          "cond": "compare",
          "left": "$timer.answer",
          "op": "!=",
          "right": "$self.row.correct"
        }
      ],
      "then": [
        {
          "do": "addVar",
          "var": "breach",
          "by": "$self.row.wrongPenalty"
        },
        {
          "do": "addVar",
          "var": "wrong",
          "by": 1
        },
        {
          "do": "log",
          "text": "That did not work on {self.name}."
        }
      ]
    }
  ],
