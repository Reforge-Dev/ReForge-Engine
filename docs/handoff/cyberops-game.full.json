  "rules": [
    {
      "id": "begin-shift",
      "when": {
        "event": "click",
        "target": "begin-shift"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "briefing"
        }
      ],
      "then": [
        {
          "do": "setVar",
          "var": "clock",
          "value": 0
        },
        {
          "do": "setVar",
          "var": "budget",
          "value": 560
        },
        {
          "do": "setVar",
          "var": "breach",
          "value": 4
        },
        {
          "do": "changeScene",
          "scene": "floor"
        },
        {
          "do": "spawnFromTable",
          "table": "incidents",
          "id": "phishing",
          "host": "ws-a"
        },
        {
          "do": "log",
          "text": "Shift started. You are the only one on call."
        },
        {
          "do": "startTimer",
          "id": "shift",
          "seconds": 180
        }
      ]
    },
    {
      "id": "spawn-next-haunting",
      "when": {
        "event": "timer",
        "id": "spawn"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "floor"
        },
        {
          "cond": "varLt",
          "var": "clock",
          "value": 56
        }
      ],
      "then": [
        {
          "do": "spawnFromTable",
          "table": "incidents",
          "markTag": "occupied",
          "maxActive": 2,
          "countVar": "spawned"
        }
      ]
    },
    {
      "id": "lose-if-breach-full",
      "when": {
        "event": "varChanged",
        "var": "breach"
      },
      "if": [
        {
          "cond": "varGt",
          "var": "breach",
          "value": 99
        }
      ],
      "then": [
        {
          "do": "setVar",
          "var": "breach",
          "value": 100
        },
        {
          "do": "log",
          "text": "Breach meter full. The network is haunted."
        },
        {
          "do": "lose"
        },
        {
          "do": "changeScene",
          "scene": "report"
        }
      ]
    },
    {
      "id": "win-if-shift-ends-under-breach",
      "when": {
        "event": "timer",
        "id": "shift"
      },
      "if": [
        {
          "cond": "varLt",
          "var": "breach",
          "value": 100
        }
      ],
      "then": [
        {
          "do": "log",
          "text": "Shift ended. The breach stayed under the line."
        },
        {
          "do": "win"
        },
        {
          "do": "changeScene",
          "scene": "report"
        }
      ]
    },
    {
      "id": "open-briefing",
      "when": {
        "event": "click",
        "target": "open-briefing"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "title"
        }
      ],
      "then": [
        {
          "do": "changeScene",
          "scene": "briefing"
        }
      ]
    },
    {
      "id": "spawn-next-haunting-late",
      "when": {
        "event": "timer",
        "id": "spawn"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "floor"
        },
        {
          "cond": "varGt",
          "var": "clock",
          "value": 55
        }
      ],
      "then": [
        {
          "do": "spawnFromTable",
          "table": "incidents",
          "markTag": "occupied",
          "maxActive": 3,
          "countVar": "spawned"
        }
      ]
    },
    {
      "id": "start-clocks",
      "when": {
        "event": "click",
        "target": "begin-shift"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "floor"
        }
      ],
      "then": [
        {
          "do": "startTimer",
          "id": "second",
          "seconds": 1,
          "repeat": true
        },
        {
          "do": "startTimer",
          "id": "spawn",
          "seconds": 14,
          "repeat": true
        }
      ]
    },
    {
      "id": "clock-and-breach",
      "when": {
        "event": "timer",
        "id": "second"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "floor"
        }
      ],
      "then": [
        {
          "do": "addVar",
          "var": "clock",
          "by": 1
        },
        {
          "do": "forEach",
          "target": "tag:occupied",
          "if": [
            {
              "cond": "hasTag",
              "tag": "lost",
              "not": true
            },
            {
              "cond": "timerRunning",
              "id": "respond",
              "target": "self",
              "not": true
            }
          ],
          "then": [
            {
              "do": "addVar",
              "var": "breach",
              "by": "$self.row.breachPerSec"
            }
          ]
        }
      ]
    },
    {
      "id": "haunting-opened",
      "when": {
        "event": "custom",
        "name": "spawned"
      },
      "then": [
        {
          "do": "setProp",
          "prop": "status",
          "value": "haunted"
        },
        {
          "do": "log",
          "text": "ALERT on {self.name}: {self.row.name}"
        },
        {
          "do": "log",
          "lines": "$self.row.logs",
          "pick": true
        },
        {
          "do": "startTimer",
          "id": "slow",
          "seconds": "$self.row.slowAfter",
          "target": "self"
        },
        {
          "do": "startTimer",
          "id": "fail",
          "seconds": "$self.row.failAfter",
          "target": "self"
        }
      ]
    },
    {
      "id": "haunting-spreads",
      "when": {
        "event": "timer",
        "id": "slow"
      },
      "if": [
        {
          "cond": "hasTag",
          "tag": "occupied"
        },
        {
          "cond": "hasTag",
          "tag": "lost",
          "not": true
        }
      ],
      "then": [
        {
          "do": "addVar",
          "var": "breach",
          "by": "$self.row.slowPenalty"
        },
        {
          "do": "log",
          "text": "{self.name} is spreading."
        }
      ]
    },
    {
      "id": "haunting-lost",
      "when": {
        "event": "timer",
        "id": "fail"
      },
      "if": [
        {
          "cond": "hasTag",
          "tag": "occupied"
        },
        {
          "cond": "hasTag",
          "tag": "lost",
          "not": true
        }
      ],
      "then": [
        {
          "do": "addTag",
          "tag": "lost"
        },
        {
          "do": "setProp",
          "prop": "status",
          "value": "lost"
        },
        {
          "do": "stopTimer",
          "id": "respond",
          "target": "self"
        },
        {
          "do": "addVar",
          "var": "breach",
          "by": "$self.row.failPenalty"
        },
        {
          "do": "addVar",
          "var": "uptime",
          "by": -10,
          "min": 0
        },
        {
          "do": "log",
          "text": "{self.name} is lost."
        }
      ]
    },
    {
      "id": "select-node",
      "when": {
        "event": "click",
        "target": "node"
      },
      "if": [
        {
          "cond": "inScene",
          "scene": "floor"
        }
      ],
      "then": [
        {
          "do": "selectEntity",
          "target": "self"
        },
        {
          "do": "log",
          "text": "Selected {self.name}."
        }
      ]
    },
    {
      "id": "respond-isolate-refused",
      "when": {
        "event": "click",
        "target": "isolate"
      },
      "if": [
        {
          "cond": "hasSelection"
        },
        {
          "cond": "compare",
          "left": "$var.budget",
          "op": "<",
          "right": 40
        }
      ],
      "then": [
        {
          "do": "log",
          "text": "Not enough budget for Isolate."
        }
      ]
    },
    {
      "id": "respond-isolate",
      "when": {
        "event": "click",
        "target": "isolate"
      },
      "if": [
        {
          "cond": "hasSelection"
        },
        {
          "cond": "hasTag",
          "target": "selected",
          "tag": "occupied"
        },
        {
          "cond": "hasTag",
          "target": "selected",
          "tag": "lost",
          "not": true
        },
        {
          "cond": "timerRunning",
          "id": "respond",
          "target": "selected",
          "not": true
        },
        {
          "cond": "compare",
          "left": "$var.budget",
          "op": ">=",
          "right": 40
        }
      ],
      "then": [
        {
          "do": "addVar",
          "var": "budget",
          "by": -40
        },
        {
          "do": "startTimer",
          "id": "respond",
          "seconds": 6,
          "target": "selected",
          "data": {
            "answer": "isolate"
          }
        },
        {
          "do": "log",
          "text": "Isolate started on {selected.name}."
        }
      ]
    },
    {
      "id": "respond-block-refused",
