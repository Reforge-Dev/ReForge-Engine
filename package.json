{
  "name": "reforge-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -F engine dev",
    "build": "pnpm -r --if-present build",
